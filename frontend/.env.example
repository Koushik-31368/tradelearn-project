# ============================================================
# TradeLearn Frontend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — NEVER commit real values.
# ============================================================

# Backend API base URL (no trailing slash)
# For local development:
REACT_APP_API_URL=http://localhost:8080

# For production (Render backend):
# REACT_APP_API_URL=https://tradelearn-project-g.onrender.com

# WebSocket / SockJS endpoint (no trailing slash, no /ws path)
# Must point to the Render backend — Vercel is serverless and cannot
# host persistent WebSocket connections.
# For local development: leave unset (falls back to REACT_APP_API_URL)
# For production: set BOTH vars in Vercel → Settings → Environment Variables
# REACT_APP_WS_URL=https://tradelearn-project-g.onrender.com

